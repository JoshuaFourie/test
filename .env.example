# ── Copy this file to .env and fill in your values ──────────────────────────

# Sophos XG Firewall connection
XG_HOST=192.168.1.1          # IP address of your XG firewall (admin interface)
XG_PORT=4444                 # Admin HTTPS port (default 4444)
XG_USERNAME=admin            # API-enabled admin username
XG_PASSWORD=your_password_here

# Parent phone MAC addresses (use colons or dashes, any case)
# Find these in: Phone Settings → Wi-Fi → tap your network → MAC address
MY_MAC=AA:BB:CC:DD:EE:FF
WIFE_MAC=11:22:33:44:55:66

# Random secret for Flask session cookies — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_hex_string
